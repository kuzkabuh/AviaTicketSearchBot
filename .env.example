# Telegram bot token from @BotFather. TELEGRAM_TOKEN is also supported for compatibility.
BOT_TOKEN=your_telegram_bot_token

# Travelpayouts / Aviasales API token.
TRAVELPAYOUTS_TOKEN=your_travelpayouts_token

# Optional affiliate marker for Aviasales links.
MARKER=

# Optional settings.
CURRENCY=rub
TRAVELPAYOUTS_BASE_URL=https://api.travelpayouts.com
REQUEST_TIMEOUT=15

# SQLite database file for price subscriptions.
DATABASE_PATH=avia_bot.sqlite3

# How many search results to show to the user.
TICKET_RESULTS_LIMIT=5

# Minimum expected number of variants; if API returns fewer, the bot warns the user.
MIN_TICKET_RESULTS=5

# Enable or disable automatic subscription price checks.
PRICE_TRACKING_ENABLED=true

# Interval between automatic price checks in minutes.
PRICE_CHECK_INTERVAL_MINUTES=60

# Cooldown for repeated "flight not found" notifications.
SUBSCRIPTION_NOT_FOUND_NOTIFY_INTERVAL_HOURS=24

# Cooldown reserved for duplicate notification protection.
DUPLICATE_NOTIFICATION_COOLDOWN_MINUTES=30

# Telegram IDs allowed to open /admin and run updates. Use comma-separated IDs.
ADMIN_TELEGRAM_IDS=123456789

# Git / self-update settings.
BOT_PROJECT_DIR=/opt/Bots/AviaTicketSearchBot
BOT_GIT_BRANCH=master
BOT_SERVICE_NAME=avia-ticket-bot.service
BOT_UPDATE_SCRIPT=/opt/Bots/AviaTicketSearchBot/update.sh
BOT_UPDATE_LOG_PATH=/opt/Bots/AviaTicketSearchBot/logs/update.log
BOT_UPDATE_LOCK_PATH=/opt/Bots/AviaTicketSearchBot/runtime/update.lock
BOT_UPDATE_STATUS_PATH=/opt/Bots/AviaTicketSearchBot/runtime/update_status.json
BOT_UPDATE_COMMAND_TIMEOUT_SECONDS=120

# Set false only if the bot OS user can restart the service without sudo.
BOT_SERVICE_RESTART_WITH_SUDO=true
